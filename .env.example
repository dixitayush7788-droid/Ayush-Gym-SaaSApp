# =============================================================================
# Supabase — Public (safe to expose to the browser)
# Find these in: Supabase Dashboard → Project Settings → API
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# =============================================================================
# Supabase — Server-side ONLY (NEVER prefix with NEXT_PUBLIC_)
# Required only for trusted backend jobs (webhooks, cron, migrations).
# Do NOT import this into any client component or the browser bundle.
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# =============================================================================
# App
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
